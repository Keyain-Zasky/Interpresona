[Unit]
Description=Final Fantasy XIV Italian Translation Portal & API Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/ffxiv-portal
Environment="PATH=/opt/ffxiv-portal/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
EnvironmentFile=/etc/ffxiv-portal.env
ExecStart=/opt/ffxiv-portal/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2 --no-access-log --no-server-header
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ffxiv-portal/data
PrivateDevices=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
